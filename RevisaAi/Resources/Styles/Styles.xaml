    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Fundo}, Dark={StaticResource FundoEscuro}}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <!-- Barra superior sempre escura, como a moldura de um painel -->
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource Carbono}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource TextoEscuro}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource TextoEscuro}" />
        <Setter Property="Shell.DisabledColor" Value="{StaticResource TextoSuaveEscuro}" />
        <Setter Property="Shell.UnselectedColor" Value="{StaticResource TextoSuaveEscuro}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.FlyoutBackgroundColor" Value="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieEscuro}}" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieEscuro}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource AmbarTexto}, Dark={StaticResource Ambar}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource AmbarTexto}, Dark={StaticResource Ambar}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource TextoSuave}, Dark={StaticResource TextoSuaveEscuro}}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource White}}" />
        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource White}}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource Magenta}, Dark={StaticResource White}}" />
        <Setter Property="UnselectedTabColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}" />
        <Setter Property="SelectedTabColor" Value="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray200}}" />
    </Style>

    <!-- ================= Estilos do tema RevisaAi "Painel" ================= -->

    <!-- Linha fina que separa blocos e itens de lista -->
    <Style TargetType="BoxView" x:Key="Linha">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Linha}, Dark={StaticResource LinhaEscuro}}" />
        <Setter Property="HeightRequest" Value="1"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
    </Style>

    <!-- Linha fina vertical (separa os mostradores lado a lado) -->
    <Style TargetType="BoxView" x:Key="LinhaVertical">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Linha}, Dark={StaticResource LinhaEscuro}}" />
        <Setter Property="WidthRequest" Value="1"/>
        <Setter Property="VerticalOptions" Value="Fill"/>
    </Style>

    <!-- Bloco com contorno fino (ajustes, sobre) -->
    <Style TargetType="Border" x:Key="Cartao">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieEscuro}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Linha}, Dark={StaticResource LinhaEscuro}}" />
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 4"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <!-- Casa de um dígito do hodômetro -->
    <Style TargetType="Border" x:Key="Digito">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieEscuro}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Borda}, Dark={StaticResource BordaEscuro}}" />
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 3"/>
        <Setter Property="WidthRequest" Value="42"/>
        <Setter Property="HeightRequest" Value="58"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style TargetType="Label" x:Key="DigitoTexto">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="FontFamily" Value="PlexMono"/>
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>

    <!-- Título de tela e de formulário -->
    <Style TargetType="Label" x:Key="Titulo">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="FontFamily" Value="BarlowCondBold"/>
        <Setter Property="FontSize" Value="26"/>
    </Style>

    <!-- Título de seção -->
    <Style TargetType="Label" x:Key="TituloSecao">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="FontFamily" Value="BarlowCondSemiBold"/>
        <Setter Property="FontSize" Value="19"/>
    </Style>

    <!-- Título de um item de lista -->
    <Style TargetType="Label" x:Key="ItemTitulo">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="FontFamily" Value="BarlowSemiBold"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>

    <!-- Texto de apoio (rótulos, detalhes) -->
    <Style TargetType="Label" x:Key="TextoSuave">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoSuave}, Dark={StaticResource TextoSuaveEscuro}}" />
        <Setter Property="FontFamily" Value="Barlow"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- Números: valores, datas e quilometragem -->
    <Style TargetType="Label" x:Key="Mono">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="FontFamily" Value="PlexMono"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>

    <Style TargetType="Label" x:Key="MonoSuave">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoSuave}, Dark={StaticResource TextoSuaveEscuro}}" />
        <Setter Property="FontFamily" Value="PlexMono"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- Número ou situação em âmbar (avisos, pendências) -->
    <Style TargetType="Label" x:Key="MonoDestaque">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AmbarTexto}, Dark={StaticResource Ambar}}" />
        <Setter Property="FontFamily" Value="PlexMono"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- Número grande dos mostradores -->
    <Style TargetType="Label" x:Key="MonoGrande">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="FontFamily" Value="PlexMono"/>
        <Setter Property="FontSize" Value="17"/>
    </Style>

    <!-- Botão contornado (Cancelar, atalhos) -->
    <Style TargetType="Button" x:Key="BotaoSecundario">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Borda}, Dark={StaticResource BordaEscuro}}" />
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="FontFamily" Value="BarlowSemiBold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="MinimumHeightRequest" Value="46"/>
    </Style>

    <!-- Botão contornado em vermelho (Excluir) -->
    <Style TargetType="Button" x:Key="BotaoPerigo">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Perigo}, Dark={StaticResource PerigoEscuro}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Perigo}, Dark={StaticResource PerigoEscuro}}" />
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="FontFamily" Value="BarlowSemiBold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="MinimumHeightRequest" Value="46"/>
    </Style>

</ResourceDictionary>
