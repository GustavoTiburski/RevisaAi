<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RevisaAi.ModelView"
             xmlns:model="clr-namespace:RevisaAi.Model"
             x:Class="RevisaAi.View.AbastecimentoFormPage"
             x:DataType="vm:CAbastecimentoFormViewModel"
             Title="Abastecimento">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10" Padding="16">

        <Label Grid.Row="0" Text="{Binding Titulo}" Style="{StaticResource Titulo}"/>

        <ScrollView Grid.Row="1">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnDefinitions="*,*" RowSpacing="4" ColumnSpacing="12">

                <Label Grid.Row="0" Grid.ColumnSpan="2" Text="Veículo *"/>
                <Picker Grid.Row="1" Grid.ColumnSpan="2" Title="Selecione o veículo"
                        ItemsSource="{Binding Veiculos}"
                        SelectedItem="{Binding VeiculoSelecionado}"/>

                <Label Grid.Row="2" Grid.Column="0" Text="Data *"/>
                <Label Grid.Row="2" Grid.Column="1" Text="Km *"/>
                <DatePicker Grid.Row="3" Grid.Column="0" Date="{Binding Data}" Format="dd/MM/yyyy"/>
                <Entry Grid.Row="3" Grid.Column="1" Text="{Binding Km}" Placeholder="Ex.: 152000"
                       Keyboard="Numeric" MaxLength="7"/>

                <Label Grid.Row="4" Grid.Column="0" Text="Litros *"/>
                <Label Grid.Row="4" Grid.Column="1" Text="Valor total (R$) *"/>
                <Entry Grid.Row="5" Grid.Column="0" Text="{Binding Litros}" Placeholder="Ex.: 35,5"
                       Keyboard="Numeric" MaxLength="7"/>
                <Entry Grid.Row="5" Grid.Column="1" Text="{Binding ValorTotal}" Placeholder="Ex.: 200,00"
                       Keyboard="Numeric" MaxLength="10"/>

                <Label Grid.Row="6" Grid.ColumnSpan="2" Text="Combustível" Margin="0,8,0,0"/>
                <HorizontalStackLayout Grid.Row="7" Grid.ColumnSpan="2" Spacing="6"
                                       RadioButtonGroup.GroupName="combustivel">
                    <RadioButton Content="Gasolina" IsChecked="{Binding EhGasolina}"/>
                    <RadioButton Content="Etanol" IsChecked="{Binding EhEtanol}"/>
                    <RadioButton Content="Diesel" IsChecked="{Binding EhDiesel}"/>
                </HorizontalStackLayout>

                <Grid Grid.Row="8" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*">
                    <CheckBox Grid.Column="0" IsChecked="{Binding TanqueCheio}" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="Completou o tanque" VerticalOptions="Center"/>
                </Grid>
            </Grid>
        </ScrollView>

        <!-- Botões de ação -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Button Grid.Column="0" Text="Salvar" Command="{Binding SalvarCommand}"/>
            <Button Grid.Column="1" Text="Excluir" Command="{Binding ExcluirCommand}"
                    IsVisible="{Binding EmEdicao}" Style="{StaticResource BotaoPerigo}"/>
            <Button Grid.Column="2" Text="Cancelar" Command="{Binding CancelarCommand}"
                    Style="{StaticResource BotaoSecundario}"/>
        </Grid>

    </Grid>
</ContentPage>
