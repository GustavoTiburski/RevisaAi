<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RevisaAi.ModelView"
             xmlns:model="clr-namespace:RevisaAi.Model"
             x:Class="RevisaAi.View.AbastecimentosPage"
             x:DataType="vm:CAbastecimentosViewModel"
             Title="Abastecimentos">

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8" Padding="16,12">

        <!-- Filtro em tempo real -->
        <SearchBar Grid.Row="0"
                   Placeholder="Buscar por veículo ou combustível..."
                   Text="{Binding Filtro}"/>

        <Label Grid.Row="1" Text="{Binding Resumo}" Style="{StaticResource TextoSuave}" HorizontalOptions="End"/>

        <!-- Lista de abastecimentos: toque em um item para editar ou excluir -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Abastecimentos}"
                        SelectionMode="Single"
                        SelectionChanged="cvLista_SelectionChanged">
            <CollectionView.EmptyView>
                <Label Text="Nenhum abastecimento encontrado. Toque em 'Novo abastecimento' para registrar."
                       Style="{StaticResource TextoSuave}" FontSize="14"
                       HorizontalTextAlignment="Center" LineBreakMode="WordWrap"
                       Margin="24,40"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:CAbastecimento">
                    <Grid RowDefinitions="Auto,1" Padding="4,0">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,10">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                    <Label Text="{Binding Titulo}" Style="{StaticResource ItemTitulo}"/>
                                    <Label Text="{Binding Detalhe}" Style="{StaticResource TextoSuave}"/>
                                    <Label Text="{Binding Tanque}" Style="{StaticResource TextoSuave}"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding ValorTexto}" Style="{StaticResource Mono}"
                                       VerticalOptions="Center"/>
                            </Grid>
                        <BoxView Grid.Row="1" Style="{StaticResource Linha}"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="3" Text="+ Novo abastecimento" Command="{Binding NovoCommand}"/>

    </Grid>
</ContentPage>
