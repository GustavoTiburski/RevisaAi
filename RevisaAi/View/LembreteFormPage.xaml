<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RevisaAi.ModelView"
             xmlns:model="clr-namespace:RevisaAi.Model"
             x:Class="RevisaAi.View.LembreteFormPage"
             x:DataType="vm:CLembreteFormViewModel"
             Title="Lembrete">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10" Padding="16">

        <Label Grid.Row="0" Text="{Binding Titulo}" Style="{StaticResource Titulo}"/>

        <ScrollView Grid.Row="1">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnDefinitions="*,*" RowSpacing="4" ColumnSpacing="12">

                <Label Grid.Row="0" Grid.ColumnSpan="2" Text="Veículo *"/>
                <Picker Grid.Row="1" Grid.ColumnSpan="2" Title="Selecione o veículo"
                        ItemsSource="{Binding Veiculos}"
                        SelectedItem="{Binding VeiculoSelecionado}"/>

                <Label Grid.Row="2" Grid.ColumnSpan="2" Text="Descrição *"/>
                <Entry Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Descricao}"
                       Placeholder="Ex.: Trocar óleo e filtro" MaxLength="60"/>

                <Label Grid.Row="4" Grid.Column="0" Text="Data limite *"/>
                <Label Grid.Row="4" Grid.Column="1" Text="Km alvo (opcional)"/>
                <DatePicker Grid.Row="5" Grid.Column="0" Date="{Binding DataAlvo}" Format="dd/MM/yyyy"/>
                <Entry Grid.Row="5" Grid.Column="1" Text="{Binding KmAlvo}" Placeholder="Ex.: 160000"
                       Keyboard="Numeric" MaxLength="7"/>

                <Grid Grid.Row="6" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*">
                    <CheckBox Grid.Column="0" IsChecked="{Binding Concluido}" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="Já foi feito (concluído)" VerticalOptions="Center"/>
                </Grid>
            </Grid>
        </ScrollView>

        <!-- Botões de ação -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Button Grid.Column="0" Text="Salvar" Command="{Binding SalvarCommand}"/>
            <Button Grid.Column="1" Text="Excluir" Command="{Binding ExcluirCommand}"
                    IsVisible="{Binding EmEdicao}" Style="{StaticResource BotaoPerigo}"/>
            <Button Grid.Column="2" Text="Cancelar" Command="{Binding CancelarCommand}"
                    Style="{StaticResource BotaoSecundario}"/>
        </Grid>

    </Grid>
</ContentPage>
